        "opc@129.80.158.0",
        "OCI_CONFIG_PROFILE=DEFAULT OCI_CONFIG_FILE=/home/opc/.oci/config OCI_CLI_SUPPRESS_FILE_PERMISSIONS_WARNING=True FASTMCP_LOG_LEVEL=ERROR /home/opc/oracle-mcp/.venv/bin/oracle.oci-api-mcp-server"
